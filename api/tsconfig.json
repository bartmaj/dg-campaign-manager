{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "../db/**/*.ts", "../domain/**/*.ts"],
  "exclude": ["**/*.test.ts", "../domain/**/*.test.ts", "../db/**/*.test.ts"]
}
